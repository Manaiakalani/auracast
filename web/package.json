{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "tokens": "node scripts/build-m3-tokens.mjs",
    "check:no-em-dash": "node scripts/check-no-em-dash.mjs",
    "check:visual": "node test/visual/full-audit.mjs",
    "check:patterns": "node test/visual/pattern-audit.mjs --check",
    "snap:patterns": "node test/visual/pattern-audit.mjs",
    "update:patterns-baseline": "node test/visual/pattern-audit.mjs --update",
    "prebuild": "npm run tokens && npm run check:no-em-dash",
    "predev": "npm run tokens",
    "check:a11y": "node test/visual/a11y-audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@material/material-color-utilities": "~0.3.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.11.4",
    "postcss": "^8.5.33",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "buffer": "^6.0.3",
    "jpeg-js": "^0.4.4",
    "qrcode": "^1.5.4",
    "three": "^0.187.0"
  }
}
